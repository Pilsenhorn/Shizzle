---
import type { CollectionEntry } from "astro:content";

interface Props {
  settings: CollectionEntry<"settings">;
}

const { settings } = Astro.props;
const trust = settings.data.contactTrust || [];
---

<section
  id="contact"
  class="px-(--space-sm) py-(--space-lg) md:px-(--space-md) lg:px-(--space-lg)"
>
  <div class="mx-auto max-w-7xl">

    <div
      class="
        relative
        overflow-hidden
        rounded-2xl
        border
        border-(--text-primary)/10
        bg-(--color-surface)
        p-(--space-sm)
        md:p-(--space-md)
        lg:p-(--space-lg)
      "
    >

      <!-- DECORATIVE BACK LAYER -->
      <div
        class="
          absolute
          right-4
          top-1/2
          hidden
          h-[85%]
          w-[38%]
          -translate-y-1/2
          rotate-3
          overflow-hidden
          rounded-2xl
          border
          border-(--text-primary)/10
          opacity-60
          lg:block
        "
      >
        <img
          src="/pictures/Shizzle.png"
          alt=""
          loading="lazy"
          class="
            h-full
            w-full
            object-contain
            object-bottom
            opacity-40
          "
        />
      </div>


      <!-- FRONT CARD -->
      <div
        class="
          relative
          z-10
          grid
          gap-(--space-lg)
          rounded-2xl
          border
          border-(--text-primary)/10
          bg-(--color-background)/90
          p-(--space-md)
          backdrop-blur-md
          md:p-(--space-lg)
          lg:grid-cols-[1fr_0.8fr]
          lg:items-center
        "
      >

        <!-- LEFT SIDE -->
        <div class="text-center md:text-left">

          <h2 class="text-2xl font-semibold md:text-3xl lg:text-4xl">
            {settings.data.contactTitle || "Contact"}
          </h2>

          {settings.data.contactText && (
            <p
              class="
                mt-(--space-sm)
                max-w-2xl
                text-base
                leading-relaxed
                text-(--text-muted)
                md:text-lg
              "
            >
              {settings.data.contactText}
            </p>
          )}

          <!-- CTA -->
          <div
            class="
              mt-(--space-md)
              flex
              flex-col
              items-stretch
              gap-(--space-sm)
              md:flex-row
              md:items-center
            "
          >

            {settings.data.linktree && (
              <a
                href={settings.data.linktree}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Open booking and contact links"
                class="
                  inline-flex
                  min-h-11
                  items-center
                  justify-center
                  rounded-md
                  bg-(--color-accent)
                  px-(--space-md)
                  py-(--space-xs)
                  text-center
                  text-(--text-primary)
                  transition
                  hover:scale-[1.02]
                  hover:bg-(--color-accent-hover)
                  hover:text-(--color-background)
                "
              >
                Book / Contact
              </a>
            )}

            <a
              href={`mailto:${settings.data.bookingEmail}`}
              class="
                inline-flex
                min-h-11
                items-center
                justify-center
                rounded-md
                border
                border-(--text-primary)
                px-(--space-md)
                py-(--space-xs)
                text-center
                text-(--text-primary)
                transition
                hover:bg-(--text-primary)
                hover:text-(--color-background)
              "
            >
              {settings.data.bookingEmail}
            </a>

          </div>


          <!-- TRUST -->
          {trust.length > 0 && (
            <ul
              class="
                mt-(--space-md)
                list-disc
                space-y-1
                pl-(--space-sm)
                text-sm
                leading-relaxed
                text-left
                text-(--text-muted)
                md:text-base
              "
            >
              {trust.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
          )}


          <!-- DOWNLOADS -->
          {settings.data.downloads && (
            <div
              class="
                mt-(--space-md)
                flex
                flex-col
                items-stretch
                gap-(--space-sm)
                md:flex-row
                md:items-center
              "
            >
              {settings.data.downloads.map(
                (file: { label: string; file: string }) => (
                  <a
                    href={file.file}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="
                       inline-flex
                        min-h-11
                        items-center
                        justify-center
                        rounded-md
                        bg-(--color-accent)
                        px-(--space-md)
                        py-(--space-xs)
                        text-center
                        text-(--text-primary)
                        transition
                        hover:scale-[1.02]
                        hover:bg-(--color-accent-hover)
                        hover:text-(--color-background)
                    "
                  >
                    {file.label}
                  </a>
                )
              )}
            </div>
          )}

        </div>


        <!-- RIGHT SIDE Obrázek se zobrazuje až od tabletu a větším displeji -->
        <div
          class="
            relative
            hidden
            min-h-80
            lg:block
          "
        >
          <img
            src="/pictures/Shizzle.png"
            alt="Shizzle"
            loading="lazy"
            class="
              absolute
              inset-0
              h-full
              w-full
              object-contain
              object-bottom
              opacity-90
              transition-transform
              duration-700
              hover:scale-[1.03]
            "
          />
        </div>

      </div>
    </div>

  </div>
</section>