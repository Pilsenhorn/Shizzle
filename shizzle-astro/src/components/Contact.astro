---
import type { CollectionEntry } from "astro:content";

interface Props {
  settings: CollectionEntry<"settings">;
}

const { settings } = Astro.props;
const trust = settings.data.contactTrust || [];
---

<section id="contact" 
         class="px-(--space-sm) py-(--space-lg) md:px-(--space-md) lg:px-(--space-lg)"
         >
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-(--space-md) md:gap-(--space-lg) lg:grid-cols-[1fr_0.9fr] lg:items-center">

      {/* Left side - Content */}
      <div class="text-left">

        {/* Headline */}
        <h2 class="text-2xl font-semibold md:text-3xl lg:text-4xl">
          {settings.data.contactTitle || "Contact"}
        </h2>

        {/* Subtext */}
        {settings.data.contactText && (
          <p class="mt-(--space-sm) max-w-2xl text-base leading-relaxed text-(--text-muted) md:text-lg">
            {settings.data.contactText}
          </p>
        )}

        {/* CTA stack */}
        <div class="mt-(--space-md) flex flex-col items-stretch gap-(--space-sm) md:flex-row md:items-center">

          {/* Primary CTA */}
          {settings.data.linktree && (
            <a
              href={settings.data.linktree}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Open booking and contact links"
              class="inline-flex min-h-11 items-center justify-center rounded-md bg-(--color-accent) px-(--space-md) py-(--space-xs) text-center text-(--text-primary) transition hover:scale-[1.02] hover:bg-(--color-accent-hover) hover:text-(--color-background)"
            >
              Book / Contact
            </a>
          )}

          {/* Secondary CTA */}
          <a
            href={`mailto:${settings.data.bookingEmail}`}
            class="inline-flex min-h-11 items-center justify-center rounded-md border border-(--text-primary)/30 px-(--space-md) py-(--space-xs) text-center text-(--text-primary) transition hover:bg-(--text-primary)/10"
          >
            {settings.data.bookingEmail}
          </a>

        </div>
        
        
        {/* Trust */}
        {trust.length > 0 && (
          <ul class="mt-(--space-md) list-disc space-y-1 pl-(--space-sm) text-sm leading-relaxed text-(--text-muted) md:text-base">
            {trust.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
       

        {settings.data.downloads && (
          <div class="mt-(--space-sm) flex flex-col items-stretch gap-(--space-xs) md:items-start">
            {settings.data.downloads.map((file: { label: string; file: string }) => (
              <a
                href={file.file}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-10 items-center rounded-md border border-(--text-primary)/20 px-(--space-sm) text-sm underline-offset-2 transition hover:bg-(--text-primary)/10 hover:underline md:min-h-0 md:border-0 md:px-0"
              >
                {file.label}
              </a>
            ))}
          </div>
        )}

      </div>

      {/* Right side - Image */}

    </div>
  </div>
</section>
