---
interface InstagramPost {
  id: string;
  timestamp: string;
  permalink: string;
  mediaType: "IMAGE" | "VIDEO";
  mediaUrl: string;
  thumbnailUrl?: string;
  caption?: string;
  sizes?: {
    small?: {
      width: number;
      height: number;
      mediaUrl: string;
    };
    medium?: {
      width: number;
      height: number;
      mediaUrl: string;
    };
    large?: {
      width: number;
      height: number;
      mediaUrl: string;
    };
    full?: {
      width: number;
      height: number;
      mediaUrl: string;
    };
  };
}

interface BeholdFeed {
  biography?: string;
  profilePictureUrl?: string;
  website?: string;
  followersCount?: number;
  followsCount?: number;
  posts: InstagramPost[];
}

const feedUrl =
  import.meta.env.BEHOLD_FEED_URL?.trim();

let feed: BeholdFeed | null = null;
let error: string | null = null;

try {
  if (!feedUrl) {
    throw new Error(
      "Missing BEHOLD_FEED_URL environment variable"
    );
  }

  const response = await fetch(feedUrl);

  if (!response.ok) {
    throw new Error(
      `Behold feed returned ${response.status}`
    );
  }

  feed = await response.json();
} catch (err) {
  console.error(
    "Behold Instagram feed error:",
    err
  );

  error =
    err instanceof Error
      ? err.message
      : "Instagram feed se nepodařilo načíst.";
}
---

<section
  id="media"
  class="px-(--space-sm) py-(--space-lg) md:px-(--space-md) lg:px-(--space-lg)"
>
  <div class="mx-auto max-w-7xl">

    <div class="mb-(--space-md)">
      <h2 class="text-center text-3xl font-semibold">
        Sleduj mě
      </h2>
    </div>

    {error ? (
      <p class="text-center text-sm opacity-60">
        Instagram feed se momentálně nepodařilo načíst.
      </p>
    ) : feed?.posts?.length ? (
      <div
        class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6"
      >
        {feed.posts.map((post) => {
          const imageUrl =
            post.mediaType === "VIDEO"
              ? post.thumbnailUrl
              : post.sizes?.large?.mediaUrl ??
                post.sizes?.medium?.mediaUrl ??
                post.mediaUrl;

          return (
            <a
              href={post.permalink}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Otevřít příspěvek na Instagramu"
              class="group relative z-0 aspect-4/5 overflow-hidden rounded-2xl transition-transform duration-300 hover:z-10 hover:scale-105"
            >
              {imageUrl && (
                <img
                  src={imageUrl}
                  alt={
                    post.caption ||
                    "Instagram příspěvek"
                  }
                  width="1000"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              )}

              <div
                class="absolute inset-0 bg-black/0 transition-colors duration-300 group-hover:bg-black/20"
              ></div>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="text-center text-sm opacity-60">
        Žádné příspěvky.
      </p>
    )}

  </div>
</section>