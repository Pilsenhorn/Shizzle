---
import type { CollectionEntry } from "astro:content";

interface Props {
  socials: CollectionEntry<"social">[];
}

const { socials } = Astro.props;
---

<section id="media" class="px-(--space-sm) py-(--space-lg) md:px-(--space-md) lg:px-(--space-lg)">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-3 gap-1 md:grid-cols-4 md:gap-2 lg:grid-cols-6">
      {socials.map((item) => (
        <a
          href={item.data.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group aspect-4/8 overflow-hidden rounded-sm bg-(--color-surface) transition duration-300 hover:scale-[1.02] md:rounded-md"
        >
          <img
            src={item.data.thumbnail}
            alt={item.data.title || "Instagram reel"}
            loading="lazy"
            class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
          />
        </a>
      ))}
    </div>
    
  </div>
</section>
