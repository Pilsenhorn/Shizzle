---
import type { CollectionEntry } from "astro:content";

interface Props {
  concerts: CollectionEntry<"concerts">[];
}

const { concerts } = Astro.props;

// VRSTVA 1 – hlavní background
const backgroundImage = "/pictures/Koncerty/1_wall.png";

// VRSTVA 2 – Shizzle white spray
const foregroundImage = "/pictures/Koncerty/3_wall_spray.png";
---

<section
  id="shows"
  class="
    relative
    overflow-hidden
    bg-(--color-background)
    px-(--space-sm)
    py-(--space-lg)
    md:min-h-[85svh]
    md:px-(--space-md)
    lg:px-(--space-lg)
  "
>
  {/* =========================================================
      VRSTVA 1
      Hlavní background
      ========================================================= */}

  {backgroundImage && (
    <img
      src={backgroundImage}
      alt=""
      aria-hidden="true"
      class="
        pointer-events-none
        absolute
        inset-0
        z-0
        h-full
        w-full
        object-cover
        object-[center_bottom]
        scale-[1.45]
        md:scale-100
        md:object-[center_80%]
      "
    />
  )}

  {/* =========================================================
      VRSTVA 2
      Shizzle white spray
      ========================================================= */}

  {foregroundImage && (
    <img
      src={foregroundImage}
      alt=""
      aria-hidden="true"
      class="
        pointer-events-none
        absolute
        right-0
        bottom-0
        z-10
        h-auto
        w-[45%]
      "
    />
  )}

  {/* =========================================================
      HORNÍ GRADIENT
      ========================================================= */}

  <div
    class="
      pointer-events-none
      absolute
      inset-x-0
      top-0
      z-20
      h-24
      bg-linear-to-b
      from-(--color-background)
      to-transparent
    "
  ></div>

  {/* =========================================================
      DOLNÍ GRADIENT
      ========================================================= */}

  <div
    class="
      pointer-events-none
      absolute
      inset-x-0
      bottom-0
      z-20
      h-32
      bg-linear-to-t
      from-(--color-background)
      to-transparent
    "
  ></div>

  {/* =========================================================
      VRSTVA 3
      Obsah koncertů
      ========================================================= */}

  <div
    class="
      relative
      z-30
      mx-auto
      flex
      w-full
      max-w-360
      flex-col
      items-center
    "
  >
    {/* =======================================================
        HEADING
        ======================================================= */}

    <div class="mb-(--space-md)">
      <h2
        class="
          text-center
          text-2xl
          font-semibold
          uppercase
          md:text-3xl
        "
      >
        co na srdci, to na jazyku...
      </h2>

      <p class="mt-(--space-xs) text-center text-sm text-white">
        ...živě, bez filtru
      </p>
    </div>

    {/* =======================================================
        CAROUSEL WRAPPER
        ======================================================= */}

    <div class="relative w-full">

      {/* =====================================================
          LEVÁ ŠIPKA
          Pouze desktop
          ===================================================== */}

      <button
        id="concert-prev"
        type="button"
        aria-label="Předchozí koncert"
        class="
          absolute
          left-0
          top-1/2
          z-40
          hidden
          -translate-y-1/2
          lg:block
          lg:left-[-14%]
        "
      >
        <img
          src="/pictures/Koncerty/2_leva_sipka.png"
          alt=""
          aria-hidden="true"
          class="h-24 w-auto"
        />
      </button>

      {/* =====================================================
          CAROUSEL
          Mobile + tablet = swipe
          Desktop = JS + šipky
          ===================================================== */}

      <div
        id="concert-carousel"
        class="
          flex
          w-full
          snap-x
          snap-mandatory
          gap-4
          overflow-x-auto
          overflow-y-hidden
          scroll-smooth
          px-[10%]

          [scrollbar-width:none]
          [-ms-overflow-style:none]
          [&::-webkit-scrollbar]:hidden

          lg:px-0
        "
      >
        {concerts.map((show, index) => {
          const date = new Date(`${show.data.date}T00:00:00`);

          return (
            <a
              href={show.data.website || show.data.ticketUrl || "#"}
              target={
                show.data.website || show.data.ticketUrl
                  ? "_blank"
                  : undefined
              }
              rel={
                show.data.website || show.data.ticketUrl
                  ? "noopener noreferrer"
                  : undefined
              }
              class={`
                group
                relative
                flex
                shrink-0
                snap-center
                items-center
                justify-center
                transition-transform
                duration-300
                hover:z-40
                hover:scale-105

                w-[72vw]
                min-w-[72vw]

                md:w-[58vw]
                md:min-w-[58vw]

                lg:w-[44%]
                lg:min-w-[44%]

                ${index === 0 ? "lg:-translate-y-2" : ""}
                ${index === 1 ? "lg:translate-y-12" : ""}
                ${index === 2 ? "lg:-translate-y-8" : ""}
              `}
            >
              {/* =================================================
                  BUBLINA
                  ================================================= */}

              <img
                src={show.data.image}
                alt=""
                aria-hidden="true"
                class="
                  pointer-events-none
                  block
                  h-auto
                  w-full
                "
                loading="lazy"
              />

              {/* =================================================
                  TEXT UVNITŘ BUBLINY
                  ================================================= */}

              <div
                class="
                  absolute
                  inset-0
                  flex
                  flex-col
                  items-center
                  justify-center
                  px-[18%]
                  py-[16%]
                  text-center
                "
              >
                {/* Datum */}

                <p
                  class="
                    text-xs
                    text-(--text-muted)
                    transition-colors
                    duration-300
                    group-hover:text-(--text-primary)
                    md:text-sm
                    lg:text-2xl
                  "
                >
                  {date.toLocaleDateString("cs-CZ", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  })}
                </p>

                {/* Město */}

                <h3
                  class="
                    mt-1
                    text-2xl
                    font-semibold
                    text-(--text-primary)
                    md:text-3xl
                    lg:text-3xl
                  "
                >
                  {show.data.city}
                </h3>

                {/* Venue */}

                <p
                  class="
                    mt-1
                    text-sm
                    text-(--text-muted)
                    md:text-base
                    lg:text-lg
                  "
                >
                  {show.data.venue}
                </p>

                {/* Support */}

                {show.data.support && (
                  <p
                    class="
                      mt-2
                      text-xs
                      text-(--text-muted)
                      md:text-sm
                      lg:text-lg
                    "
                  >
                    {show.data.support}
                  </p>
                )}

                {/* Description */}

                {show.data.description && (
                  <p
                    class="
                      mt-2
                      line-clamp-3
                      text-xs
                      leading-relaxed
                      text-(--text-muted)
                      md:text-sm
                    "
                  >
                    {show.data.description}
                  </p>
                )}

                {/* Ticket */}

                {show.data.ticketUrl && (
                  <span
                    class="
                      mt-3
                      rounded-full
                      border
                      border-(--text-primary)
                      px-3
                      py-1
                      text-[10px]
                      font-medium
                      uppercase
                      tracking-wide
                      text-(--text-primary)
                      transition-all
                      duration-300
                      group-hover:bg-(--color-accent)
                      md:text-xs
                    "
                  >
                    Vstupenky
                  </span>
                )}
              </div>
            </a>
          );
        })}
      </div>

      {/* =====================================================
          PRAVÁ ŠIPKA
          Pouze desktop
          ===================================================== */}

      <button
        id="concert-next"
        type="button"
        aria-label="Další koncert"
        class="
          absolute
          right-0
          top-1/2
          z-40
          hidden
          -translate-y-1/2
          lg:block
          lg:right-[-14%]
        "
      >
        <img
          src="/pictures/Koncerty/2_prava_sipka.png"
          alt=""
          aria-hidden="true"
          class="h-24 w-auto"
        />
      </button>

    </div>

    {/* =======================================================
        CAROUSEL JS
        ======================================================= */}

    <script>
      const carousel = document.querySelector("#concert-carousel");
      const prevButton = document.querySelector("#concert-prev");
      const nextButton = document.querySelector("#concert-next");

      if (
        carousel instanceof HTMLElement &&
        prevButton instanceof HTMLButtonElement &&
        nextButton instanceof HTMLButtonElement
      ) {
        const slides = Array.from(carousel.children).filter(
          (child): child is HTMLElement => child instanceof HTMLElement,
        );

        let currentIndex = 0;

        const goToSlide = (index: number) => {
          if (!slides.length) return;

          currentIndex = Math.max(
            0,
            Math.min(index, slides.length - 1),
          );

          carousel.scrollTo({
            left:
              slides[currentIndex].offsetLeft -
              carousel.offsetLeft,
            behavior: "smooth",
          });
        };

        prevButton.addEventListener("click", () => {
          goToSlide(currentIndex - 1);
        });

        nextButton.addEventListener("click", () => {
          goToSlide(currentIndex + 1);
        });
      }
    </script>

  </div>
</section>