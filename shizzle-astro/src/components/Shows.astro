---
import type { CollectionEntry } from "astro:content";

interface Props {
  concerts: CollectionEntry<"concerts">[];
}

const { concerts } = Astro.props;

const backgroundImage = "/pictures/Koncerty/1_Wall2.png";
const foregroundImage = "/pictures/Koncerty/3_wall_spray.png";
---

<section
  id="shows"
  class="
    relative
    isolate
    min-h-[100svh]
    overflow-x-clip
    px-(--space-sm)
    py-(--space-lg)

    md:px-(--space-md)

    lg:px-(--space-lg)
  "
>
  {/* FOTOGRAFIE – CELÁ, BEZ OŘEZU */}

  <div
    class="
      shows-visual-frame
      pointer-events-none
      absolute
      inset-x-0
      top-0
      z-0
    "
  >
    <div class="shows-photo-frame">
<img
  src={backgroundImage}
  alt=""
  aria-hidden="true"
  class="block h-full w-full object-cover"
/>

{/* Horní prolnutí do barvy pozadí */}
<div
  aria-hidden="true"
  class="
    pointer-events-none
    absolute
    inset-x-0
    top-0
    z-10
    h-16
    bg-linear-to-b
    from-(--color-background)
    to-transparent
  "
></div>

{/* Spodní prolnutí do barvy pozadí */}
<div
  aria-hidden="true"
  class="
    pointer-events-none
    absolute
    inset-x-0
    bottom-0
    z-10
    h-16
    bg-linear-to-t
    from-(--color-background)
    to-transparent
    landscape:h-48
  "
></div>

      {/* ŠIPKY */}

      <button
        id="concert-prev"
        type="button"
        aria-label="Předchozí koncert"
        class="
          pointer-events-auto
          absolute
          hidden
          lg:block

          lg:left-2
          lg:top-1/2
          lg:-translate-y-1/2

          xl:left-4
          2xl:left-8
        "
      >
        <img
          src="/pictures/Koncerty/2_leva_sipka.png"
          alt=""
          aria-hidden="true"
          class="h-16 w-auto lg:h-18 xl:h-20 2xl:h-26"
        />
      </button>

      <button
        id="concert-next"
        type="button"
        aria-label="Další koncert"
        class="
          pointer-events-auto
          absolute
          hidden
          lg:block

          lg:right-2
          lg:top-1/2
          lg:-translate-y-1/2

          xl:right-4
          2xl:right-8
        "
      >
        <img
          src="/pictures/Koncerty/2_prava_sipka.png"
          alt=""
          aria-hidden="true"
          class="h-16 w-auto lg:h-18 xl:h-20 2xl:h-26"
        />
      </button>
    </div>
  </div>

  {/* OBSAH KONCERTŮ */}

  <div
    class="
      relative
      z-30
      mx-auto
      flex
      w-full
      max-w-360
      flex-col
      items-center
      translate-y-[clamp(1rem,8svh,5rem)]
    "
  >
    <div class="shows-heading
        mb-(--space-sm)
         
    ">
      <h2
        class="
          text-center
          font-semibold
          uppercase
          text-xl
          md:text-2xl
          lg:text-4xl
          xl:text-6xl
          
        "
      >
        co na srdci, to na jazyku...
      </h2>

      <p class="
        mt-(--space-xs) 
        text-center 
        leading-wide
        text-white 
        text-sm 
        md:text-md
        lg:text-lg
        xl:text-2xl">
        ...živě, bez filtru
      </p>
    </div>

    <div class="relative w-full">
      <div
        id="concert-carousel"
        class="
          flex
          w-full
          snap-x
          snap-mandatory
          overflow-x-auto
          overflow-y-hidden
          scroll-smooth
          px-[10%]

          [scrollbar-width:none]
          [-ms-overflow-style:none]
          [&::-webkit-scrollbar]:hidden

          lg:py-12
          lg:gap-4
          lg:landscape:gap-2
          lg:px-0

          
          xl:max-w-[120%]
          xl:gap-4
          xl:landscape:gap-10
          xl:px-0
        "
      >
        {concerts.map((show, index) => {
          const date = new Date(`${show.data.date}T00:00:00`);

          return (
            <a
              href={show.data.website || show.data.ticketUrl || "#"}
              target={
                show.data.website || show.data.ticketUrl
                  ? "_blank"
                  : undefined
              }
              rel={
                show.data.website || show.data.ticketUrl
                  ? "noopener noreferrer"
                  : undefined
              }
              class={`
                group
                relative
                flex
                shrink-0
                snap-center
                items-center
                justify-center
                transition-transform
                duration-300
                hover:z-40
                hover:scale-105

                w-[64vw]
                min-w-[64vw]

                md:w-[52vw]
                md:min-w-[52vw]

                lg:w-[44%]
                lg:min-w-[44%]

                xl:w-[62%]
                xl:min-w-[62%]

                ${index === 0 ? "lg:-translate-y-2" : ""}
                ${index === 1 ? "lg:translate-y-12" : ""}
                ${index === 2 ? "lg:-translate-y-8" : ""}
              `}
            >
              <img
                src={show.data.image}
                alt=""
                aria-hidden="true"
                class="
                pointer-events-none 
                block 
                h-auto
                w-full
                max-sm:w-[90%]
                max-sm:py-[30%]
                sm:landscape:w-[70%]
                xl:landscape:w-full
                "
                loading="lazy"
              />

              <div
                class="
                  absolute
                  inset-x-[4%]
                  inset-y-[4%]
                  flex
                  flex-col
                  items-center
                  justify-center
                  px-[18%]
                  py-[16%]
                  scale-90
                  text-center
                  md:scale-100
                  md:inset-0
                
                "
              >
                <p
                  class="
                    text-xs
                    text-(--text-muted)
                    transition-colors
                    duration-300
                    group-hover:text-(--text-primary)
                    md:text-sm
                    lg:text-2xl
                  "
                >
                  {date.toLocaleDateString("cs-CZ", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  })}
                </p>

                <h3
                  class="
                    mt-1
                    text-2xl
                    font-semibold
                    text-(--text-primary)
                    md:text-3xl
                    lg:text-3xl
                    xl:text-4xl
                  "
                >
                  {show.data.city}
                </h3>

                <p
                  class="
                    mt-1
                    text-sm
                    text-(--text-muted)
                    md:text-base
                    lg:text-lg
                    xl:text-xl
                  "
                >
                  {show.data.venue}
                </p>

                {show.data.support && (
                  <p
                    class="
                      mt-2
                      text-xs
                      text-(--text-muted)
                      md:text-sm
                      lg:text-lg
                      xl:text-xl
                    "
                  >
                    {show.data.support}
                  </p>
                )}

                {show.data.description && (
                  <p
                    class="
                      mt-2
                      line-clamp-3
                      text-xs
                      leading-relaxed
                      text-(--text-muted)
                      md:text-sm
                      lg:text-lg
                      xl:text-xl
                    "
                  >
                    {show.data.description}
                  </p>
                )}

                {show.data.ticketUrl && (
                  <span
                    class="
                      mt-3
                      rounded-full
                      border
                      border-(--text-primary)
                      px-3
                      py-1
                      text-[10px]
                      font-medium
                      uppercase
                      tracking-wide
                      text-(--text-primary)
                      transition-all
                      duration-300
                      group-hover:bg-(--color-accent)
                      md:text-xs
                      lg:text-sm
                      xl:text-base
                    "
                  >
                    Vstupenky
                  </span>
                )}
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <script>
      const carousel = document.querySelector("#concert-carousel");
      const prevButton = document.querySelector("#concert-prev");
      const nextButton = document.querySelector("#concert-next");

      if (
        carousel instanceof HTMLElement &&
        prevButton instanceof HTMLButtonElement &&
        nextButton instanceof HTMLButtonElement
      ) {
        const slides = Array.from(carousel.children).filter(
          (child): child is HTMLElement => child instanceof HTMLElement,
        );

        let currentIndex = 0;

        const goToSlide = (index: number) => {
          if (!slides.length) return;

          currentIndex = Math.max(
            0,
            Math.min(index, slides.length - 1),
          );

          carousel.scrollTo({
            left:
              slides[currentIndex].offsetLeft -
              carousel.offsetLeft,
            behavior: "smooth",
          });
        };

        prevButton.addEventListener("click", () => {
          goToSlide(currentIndex - 1);
        });

        nextButton.addEventListener("click", () => {
          goToSlide(currentIndex + 1);
        });
      }
    </script>
  </div>
</section>

<style>
  #shows .shows-heading {
    transform: translateY(
      calc(
        max(0px, calc(50svh - 36.06vw)) +
          6.13vw -
          var(--space-xs) -
          var(--space-lg) -
          100% -
          clamp(2.5rem, 6svh, 4.5rem)
      )
    );
  }

  #shows {
    min-height: max(100svh, 72.12vw);
  }

  #shows .shows-visual-frame {
    top: 0;
    left: 50%;
    width: 100vw;
    height: max(100svh, 72.12vw);
    transform: translateX(-50%);
  }

  #shows .shows-photo-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    aspect-ratio: 2048 / 1477;
    transform: translate(-50%, -50%);
  }
</style>
