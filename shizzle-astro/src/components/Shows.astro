---
import type { CollectionEntry } from "astro:content";

interface Props {
  concerts: CollectionEntry<"concerts">[];
}

const { concerts } = Astro.props;
---

<section
  id="shows"
  class="px-(--space-sm) py-(--space-lg) md:px-(--space-md) lg:px-(--space-lg)"
>
  <div class="mx-auto max-w-7xl">

    {/* Heading */}
    <div class="mb-(--space-md)">
      <h2 class="text-center uppercase text-2xl font-semibold md:text-3xl">
        co na srdci, to na jazyku...
      </h2>

      <p class="mt-(--space-xs) text-center text-sm text-white">
        ...živě, bez filtru
      </p>
    </div>

    {/* Carousel */}
    <div
      id="shows-carousel"
      class="
        grid
        grid-flow-col
        auto-cols-[85%]
        gap-2
        overflow-x-auto
        overflow-y-visible
        overscroll-x-contain
        snap-x
        snap-mandatory
        py-4
        scrollbar-none
        sm:auto-cols-[calc((100%-16px)/3)]
        md:auto-cols-[calc((100%-24px)/4)]
        lg:auto-cols-[calc((100%-40px)/6)]
      "
    >
      {concerts.map((show) => {
        const date = new Date(show.data.date);

        return (
          <div
            class="
              group
              relative
              z-0
              aspect-4/6
              overflow-hidden
              rounded-2xl
              transition-transform
              duration-300
              hover:z-10
              hover:scale-105
            "
          >
            <a
              href={show.data.website || show.data.ticketUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="
                group
                flex
                h-full
                w-full
                flex-col
                justify-between
                rounded-xl
                bg-(--color-surface)
                p-5
                transition-all
                duration-300
                hover:-translate-y-1
                hover:scale-[1.02]
                hover:border-(--text-primary)
                hover:bg-(--color-accent)
              "
            >
              {/* Top */}
              <div>
                <p
                  class="
                    text-md
                    text-(--text-muted)
                    transition-colors
                    duration-300
                    group-hover:text-(--text-primary)
                  "
                >
                  {date.toLocaleDateString("cs-CZ", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  })}
                </p>

                <h3 class="mt-2 text-3xl font-medium">
                  {show.data.city}
                </h3>

                <p
                  class="
                    mt-1
                    text-md
                    text-(--text-muted)
                    transition-colors
                    duration-300
                    group-hover:text-(--text-primary)
                  "
                >
                  {show.data.venue}
                </p>

                {show.data.support && (
                  <p
                    class="
                      mt-3
                      text-md
                      text-(--text-muted)
                      transition-colors
                      duration-300
                      group-hover:text-(--text-primary)
                    "
                  >
                    {show.data.support}
                  </p>
                )}

                {show.data.description && (
                  <p
                    class="
                      mt-4
                      line-clamp-4
                      text-md
                      leading-relaxed
                      text-(--text-muted)
                      transition-colors
                      duration-300
                      group-hover:text-(--text-primary)
                    "
                  >
                    {show.data.description}
                  </p>
                )}
              </div>

              {/* Bottom */}
              <div class="mt-6 flex items-center justify-between gap-3">
                <span
                  class="
                    inline-block
                    text-xs
                    font-medium
                    uppercase
                    tracking-wide
                    text-(--text-primary)
                    transition-transform
                    duration-300
                    hover:-translate-y-1
                    hover:scale-105
                  "
                >
                  Odkaz na akci →
                </span>

                {show.data.ticketUrl && (
                  <span
                    class="
                      inline-block
                      rounded-full
                      border
                      border-(--text-primary)
                      px-3
                      py-1
                      text-xs
                      font-medium
                      uppercase
                      tracking-wide
                      transition-all
                      duration-300
                      hover:-translate-y-1
                      hover:scale-105
                      hover:border-(--text-primary)
                      hover:bg-(--color-accent)
                    "
                  >
                    Vstupenky
                  </span>
                )}
              </div>
            </a>
          </div>
        );
      })}
    </div>

    {/* Carousel controls */}
    <div class="mb-4 hidden justify-center gap-2 md:flex">
      <button
        id="shows-prev"
        type="button"
        aria-label="Předchozí koncert"
        class="
          flex
          h-10
          w-10
          items-center
          justify-center
          rounded-full
          border
          border-(--text-primary)
          text-lg
          transition-all
          duration-300
          hover:bg-(--color-accent)
          disabled:cursor-not-allowed
          disabled:opacity-30
        "
      >
        ←
      </button>

      <button
        id="shows-next"
        type="button"
        aria-label="Další koncert"
        class="
          flex
          h-10
          w-10
          items-center
          justify-center
          rounded-full
          border
          border-(--text-primary)
          text-lg
          transition-all
          duration-300
          hover:bg-(--color-accent)
          disabled:cursor-not-allowed
          disabled:opacity-30
        "
      >
        →
      </button>
    </div>

  </div>
</section>

<script>
  const carousel = document.querySelector("#shows-carousel");
  const prevButton = document.querySelector("#shows-prev");
  const nextButton = document.querySelector("#shows-next");

  if (
    carousel instanceof HTMLElement &&
    prevButton instanceof HTMLButtonElement &&
    nextButton instanceof HTMLButtonElement
  ) {
    const scrollAmount = () => carousel.clientWidth * 0.8;

    prevButton.addEventListener("click", () => {
      carousel.scrollBy({
        left: -scrollAmount(),
        behavior: "smooth",
      });
    });

    nextButton.addEventListener("click", () => {
      carousel.scrollBy({
        left: scrollAmount(),
        behavior: "smooth",
      });
    });
  }
</script>

<style>
  .scrollbar-none {
    scrollbar-width: none;
  }

  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>