---
import type { CollectionEntry } from "astro:content";

interface Props {
  concerts: CollectionEntry<"concerts">[];
}

const { concerts } = Astro.props;
---

<section
  id="shows"
  class="px-(--space-sm) py-(--space-lg) md:px-(--space-md) lg:px-(--space-lg)"
>
  <div class="mx-auto max-w-7xl">

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">

      {concerts.map((show) => {
        const date = new Date(show.data.date);

        return (
          <a
            href={show.data.website || show.data.ticketUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="
              group
              flex
              min-h-[340px]
              flex-col
              justify-between

              rounded-xl
              border border-(--text-primary)/10
              bg-(--color-surface)

              p-5

              transition-all
              duration-300

              hover:-translate-y-1
              hover:border-(--text-primary)/20
              hover:bg-(--color-accent)
            "
          >
            {/* top */}
            <div>

              <p class="text-sm text-(--text-muted)">
                {date.toLocaleDateString("cs-CZ", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                })}
              </p>

              <h3 class="mt-2 text-2xl font-medium">
                {show.data.city}
              </h3>

              <p class="mt-1 text-sm text-(--text-muted)">
                {show.data.venue}
              </p>

              {show.data.support && (
                <p class="mt-3 text-sm text-(--text-muted)">
                  {show.data.support}
                </p>
              )}

              {show.data.description && (
                <p class="mt-4 line-clamp-4 text-sm text-(--text-muted)">
                  {show.data.description}
                </p>
              )}
            </div>

            {/* bottom */}
            <div class="mt-6 flex items-center justify-between">

              <span
                class="
                  text-sm
                  font-medium
                  uppercase
                  tracking-wide
                  text-(--text-primary)
                "
              >
                Detail akce
              </span>

              {show.data.ticketUrl && (
                <span
                  class="
                    rounded-full
                    border
                    border-(--text-primary)/20
                    px-3
                    py-1
                    text-xs
                    uppercase
                  "
                >
                  Tickets
                </span>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>