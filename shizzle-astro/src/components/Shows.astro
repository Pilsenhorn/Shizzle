---
import type { CollectionEntry } from "astro:content";

interface Props {
  concerts: CollectionEntry<"concerts">[];
}

const { concerts } = Astro.props;

const backgroundImage = "/pictures/Koncerty/1_wall.png";
const foregroundImage = "/pictures/Koncerty/3_wall_spray.png";
---

<section
  id="shows"
  class="
    relative
    isolate
    overflow-hidden

    min-h-[75svh]
    px-(--space-sm)
    py-(--space-lg)
    landscape:min-h-0

    sm:min-h-[85svh]
    sm:landscape:min-h-[65svh]

    md:min-h-[85svh]
    md:px-(--space-md)
    md:landscape:min-h-[85svh]

    lg:min-h-[75svh]
    lg:px-(--space-lg)
    lg:landscape:min-h-[75svh]

    xl:min-h-[90svh]
    xl:landscape:min-h-[90svh]
  "
>
  {/* =========================================================
      OBRAZOVÁ KOMPOZICE
      ========================================================= */}

  <div
    class="
      shows-visual-frame
      pointer-events-none
      absolute
      left-1/2
      -top-[8svh]
      z-0
      aspect-2048/1477
      w-screen

      landscape:-top-[5svh]

      sm:-top-[12svh]
      sm:landscape:-top-[12svh]

      md:-top-[12svh]
      md:landscape:-top-[12svh]

      lg:-top-[15svh]
      lg:landscape:-top-[15svh]

      xl:-top-[20svh]
      xl:landscape:-top-[20svh]
    "
  >
    <img
      src={backgroundImage}
      alt=""
      aria-hidden="true"
      class="block h-full w-full object-contain"
    />

    {/* Gradient je pevně navázaný na spodní hranu fotografie. */}
    <div
      class="
        pointer-events-none
        absolute
        inset-x-0
        bottom-0
        z-10
        h-[22%]
        bg-linear-to-t
        from-(--color-background)
        to-transparent
      "
    ></div>

    <img
      src={foregroundImage}
      alt=""
      aria-hidden="true"
      class="
        absolute
        right-[2%]
        top-[35%]
        z-20
        h-auto
        w-[28%]
        max-w-none
      "
    />
  </div>

  {/* =========================================================
      ŠIPKY – STEJNÝ POMĚR A POZICE JAKO FOTOGRAFIE
      ========================================================= */}

  <div
    class="
      shows-visual-frame
      pointer-events-none
      absolute
      left-1/2
      -top-[8svh]
      z-0
      aspect-2048/1477
      w-screen

      landscape:-top-[5svh]

      sm:-top-[12svh]
      sm:landscape:-top-[12svh]

      md:-top-[12svh]
      md:landscape:-top-[12svh]

      lg:-top-[15svh]
      lg:landscape:-top-[15svh]

      xl:-top-[20svh]
      xl:landscape:-top-[20svh]
    "
  >
    <button
      id="concert-prev"
      type="button"
      aria-label="Předchozí koncert"
      class="
        pointer-events-auto
        absolute
        hidden
        lg:block

        lg:left-2
        lg:top-1/2
        lg:-translate-y-1/2

        xl:left-4
        2xl:left-8
      "
    >
      <img
        src="/pictures/Koncerty/2_leva_sipka.png"
        alt=""
        aria-hidden="true"
        class="h-16 w-auto lg:h-18 xl:h-20 2xl:h-26"
      />
    </button>

    <button
      id="concert-next"
      type="button"
      aria-label="Další koncert"
      class="
        pointer-events-auto
        absolute
        hidden
        lg:block

        lg:right-2
        lg:top-1/2
        lg:-translate-y-1/2

        xl:right-4
        2xl:right-8
      "
    >
      <img
        src="/pictures/Koncerty/2_prava_sipka.png"
        alt=""
        aria-hidden="true"
        class="h-16 w-auto lg:h-18 xl:h-20 2xl:h-26"
      />
    </button>
  </div>

  {/* =========================================================
      HORNÍ GRADIENT
      ========================================================= */}

  <div
    class="
      pointer-events-none
      absolute
      inset-x-0
      top-0
      z-20
      h-32
      bg-linear-to-b
      from-(--color-background)
      to-transparent
      md:h-32
    "
  ></div>

  {/* =========================================================
      OBSAH KONCERTŮ
      ========================================================= */}

  <div
    class="
      relative
      z-30
      mx-auto
      flex
      w-full
      max-w-360
      flex-col
      items-center
    "
  >
    <div class="mb-(--space-md)">
      <h2
        class="
          text-center
          text-2xl
          font-semibold
          uppercase
          md:text-4xl
          lg:text-5xl
          xl:text-6xl
        "
      >
        co na srdci, to na jazyku...
      </h2>

      <p class="mt-(--space-xs) text-center leading-wide text-sm text-white md:text-base lg:text-lg xl:text-xl">
        ...živě, bez filtru
      </p>
    </div>

    <div class="relative w-full">
      <div
        id="concert-carousel"
        class="
          flex
          w-full
          snap-x
          snap-mandatory
          gap-4
          overflow-x-auto
          overflow-y-hidden
          scroll-smooth
          px-[10%]

          [scrollbar-width:none]
          [-ms-overflow-style:none]
          [&::-webkit-scrollbar]:hidden

          lg:px-0
        "
      >
        {concerts.map((show, index) => {
          const date = new Date(`${show.data.date}T00:00:00`);

          return (
            <a
              href={show.data.website || show.data.ticketUrl || "#"}
              target={
                show.data.website || show.data.ticketUrl
                  ? "_blank"
                  : undefined
              }
              rel={
                show.data.website || show.data.ticketUrl
                  ? "noopener noreferrer"
                  : undefined
              }
              class={`
                group
                relative
                flex
                shrink-0
                snap-center
                items-center
                justify-center
                transition-transform
                duration-300
                hover:z-40
                hover:scale-105

                w-[72vw]
                min-w-[72vw]

                md:w-[58vw]
                md:min-w-[58vw]

                lg:w-[44%]
                lg:min-w-[44%]

                ${index === 0 ? "lg:-translate-y-2" : ""}
                ${index === 1 ? "lg:translate-y-12" : ""}
                ${index === 2 ? "lg:-translate-y-8" : ""}
              `}
            >
              <img
                src={show.data.image}
                alt=""
                aria-hidden="true"
                class="pointer-events-none block h-auto w-full"
                loading="lazy"
              />

              <div
                class="
                  absolute
                  inset-0
                  flex
                  flex-col
                  items-center
                  justify-center
                  px-[18%]
                  py-[16%]
                  text-center
                "
              >
                <p
                  class="
                    text-xs
                    text-(--text-muted)
                    transition-colors
                    duration-300
                    group-hover:text-(--text-primary)
                    md:text-sm
                    lg:text-2xl
                  "
                >
                  {date.toLocaleDateString("cs-CZ", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  })}
                </p>

                <h3
                  class="
                    mt-1
                    text-2xl
                    font-semibold
                    text-(--text-primary)
                    md:text-3xl
                    lg:text-3xl
                    xl:text-4xl
                  "
                >
                  {show.data.city}
                </h3>

                <p
                  class="
                    mt-1
                    text-sm
                    text-(--text-muted)
                    md:text-base
                    lg:text-lg
                    xl:text-xl
                  "
                >
                  {show.data.venue}
                </p>

                {show.data.support && (
                  <p
                    class="
                      mt-2
                      text-xs
                      text-(--text-muted)
                      md:text-sm
                      lg:text-lg
                      xl:text-xl
                    "
                  >
                    {show.data.support}
                  </p>
                )}

                {show.data.description && (
                  <p
                    class="
                      mt-2
                      line-clamp-3
                      text-xs
                      leading-relaxed
                      text-(--text-muted)
                      md:text-sm
                      lg:text-lg
                      xl:text-xl
                    "
                  >
                    {show.data.description}
                  </p>
                )}

                {show.data.ticketUrl && (
                  <span
                    class="
                      mt-3
                      rounded-full
                      border
                      border-(--text-primary)
                      px-3
                      py-1
                      text-[10px]
                      font-medium
                      uppercase
                      tracking-wide
                      text-(--text-primary)
                      transition-all
                      duration-300
                      group-hover:bg-(--color-accent)
                      md:text-xs
                      lg:text-sm
                      xl:text-base
                    "
                  >
                    Vstupenky
                  </span>
                )}
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <script>
      const carousel = document.querySelector("#concert-carousel");
      const prevButton = document.querySelector("#concert-prev");
      const nextButton = document.querySelector("#concert-next");

      if (
        carousel instanceof HTMLElement &&
        prevButton instanceof HTMLButtonElement &&
        nextButton instanceof HTMLButtonElement
      ) {
        const slides = Array.from(carousel.children).filter(
          (child): child is HTMLElement => child instanceof HTMLElement,
        );

        let currentIndex = 0;

        const goToSlide = (index: number) => {
          if (!slides.length) return;

          currentIndex = Math.max(
            0,
            Math.min(index, slides.length - 1),
          );

          carousel.scrollTo({
            left: slides[currentIndex].offsetLeft - carousel.offsetLeft,
            behavior: "smooth",
          });
        };

        prevButton.addEventListener("click", () => {
          goToSlide(currentIndex - 1);
        });

        nextButton.addEventListener("click", () => {
          goToSlide(currentIndex + 1);
        });
      }
    </script>
  </div>
</section>

<style>
  .shows-visual-frame {
    transform: translateX(-50%);
  }

  /*
    901 × 697: široký desktop, ale ne dost široký landscape.
    Fotku posuneme výš, aby modrá obloha zůstala nad horním
    gradientem a do záběru šla rovnou betonová zeď.
  */
  @media (min-aspect-ratio: 5/4) and (max-aspect-ratio: 1499/1000) {
    .shows-visual-frame {
      top: 0 !important;
      transform: translate(-50%, -25%);
    }
  }

  /*
    Skutečně široké landscape obrazovky, například 1295 × 675.
    Spodní okraj fotografie, tráva a navázaný gradient zůstanou
    uvnitř viditelné kompozice.
  */
  @media (min-aspect-ratio: 3/2) {
    #shows {
      min-height: 100svh;
    }

    .shows-visual-frame {
      top: 0 !important;
      transform: translate(-50%, calc(100svh - 100%));
    }
  }
</style>