<section
  id="hero"
  class="
    relative
    flex
    w-full
    min-h-svh
    items-center
    justify-end
    overflow-hidden
  ">

{/* 1. vrstva - fotografie */}
<picture>
  {/* Mobilní portrait */}
  <source
    media="(max-width: 768px) and (orientation: portrait)"
    srcset="/pictures/Hero/2_Shizzle_hlava_mobile.png"
  />

  {/* Landscape a desktop */}
  <source
    media="(orientation: landscape)"
    srcset="/pictures/Hero/2_Shizzle_hlava.webp"
  />

  <img
    src="/pictures/Hero/2_Shizzle_hlava.webp"
    alt="Shizzle"
    width="1536"
    height="1024"
    fetchpriority="high"
    loading="eager"
    class="
      absolute
      inset-0
      z-10
      h-full
      w-full
      max-w-none
      object-cover
      object-center
      opacity-80
    "
  />
</picture>
  {/* 2. vrstva - filtr / textura */}
  <img
    src="/pictures/Hero/Filtr.webp"
    alt=""
    aria-hidden="true"
    class="
      pointer-events-none
      absolute
      inset-0
      z-20
      h-full
      w-full
      object-cover
      opacity-50
    "
  />

  {/* 3. vrstva - logo */}
  <div
    class="
      absolute
      inset-0
      z-30
      flex
      w-full
      items-center
      justify-center
      p-4
      text-center
      sm:p-8
    "
  >
    <div class="w-full sm:max-w-xl md:max-w-2xl lg:max-w-4xl xl:max-w-7xl">
      <h1>
        <img
          src="/logo/Logo2.webp"
          alt="Shizzle"
          width="1774"
          height="887"
          class="h-auto w-full drop-shadow-lg"
          loading="eager"
        />
      </h1>
    </div>
  </div>

  {/* Přechod Hero → další sekce */}
  <div
    class="
      pointer-events-none
      absolute
      inset-x-0
      bottom-0
      z-40
      h-24
      bg-linear-to-b
      from-transparent
      to-(--color-background)
      sm:h-28
      md:h-64
    "
  ></div>
  <div 
    id="hero-end"
    class="pointer-events-none h-px w-full">
  </div>

</section>