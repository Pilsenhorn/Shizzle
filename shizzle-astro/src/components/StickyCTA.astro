---
import type { CollectionEntry } from "astro:content";

interface Props {
  settings: CollectionEntry<"settings">;
}

const { settings } = Astro.props;
---

{settings.data.linktree && (
  <a
    href={settings.data.linktree}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Booking kontakt"
    class="fixed right-[-3.2rem] bottom-8 z-50 -rotate-90 rounded-t-xl rounded-b-none border border-white/10 bg-[rgba(38,55,58,0.72)] px-6 py-3 text-sm font-medium uppercase tracking-wide text-(--text-primary) shadow-2xl backdrop-blur-md transition-all duration-300 hover:right-[-2.8rem] hover:bg-(--color-accent-hover) hover:text-white md:px-8 md:py-4 md:text-base"
  >
    Book Me
  </a>
)}
