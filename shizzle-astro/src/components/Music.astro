---
import type { CollectionEntry } from "astro:content";

interface Props {
  albums: CollectionEntry<"albums">[];
}

const { albums } = Astro.props;
---

<section
  id="music"
  class="px-(--space-sm) py-(--space-lg) md:px-(--space-md) lg:px-(--space-lg)"
>
  <div class="mx-auto max-w-7xl">

    <div class="mb-(--space-md)">
      <h2 class="text-2xl md:text-3xl font-semibold">
        Alba
      </h2>
    </div>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
      {albums.map((album) => (
        <a
          href={album.data.spotify}
          target="_blank"
          rel="noopener noreferrer"
          class="
            group
            overflow-hidden
            rounded-md
            bg-(--color-surface)
            transition
            duration-300
            hover:scale-[1.02]
          "
        >
          <img
            src={album.data.cover}
            alt={album.data.title}
            loading="lazy"
            class="
              aspect-square
              w-full
              object-cover
              transition
              duration-300
              group-hover:scale-105
            "
          />

          <div class="p-3">
            <p class="font-medium">
              {album.data.title}
            </p>

            <p class="text-sm text-(--text-muted)">
              {album.data.year}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>