---
import type { CollectionEntry } from "astro:content";

interface Props {
  concert: CollectionEntry<"concerts">;
}

const { concert } = Astro.props;

const formattedDate = new Date(concert.data.date).toLocaleDateString("cs-CZ", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<div
  id="concert-modal"
  class="fixed inset-0 z-50 hidden items-end justify-center bg-black/40 px-(--space-sm) py-(--space-sm) opacity-0 backdrop-blur-md transition duration-300 md:items-center md:px-(--space-md)"
>
  <div
    id="modal-content"
    class="relative w-full max-w-md scale-95 rounded-lg border border-white/10 bg-white/5 p-(--space-sm) text-(--text-primary) opacity-0 shadow-2xl backdrop-blur-xl transition duration-300 md:p-(--space-md)"
    style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.1)"
  >
    <button
      id="close-modal"
      class="absolute right-(--space-sm) top-(--space-sm) rounded-full bg-white/10 p-2 text-(--text-muted) backdrop-blur transition hover:bg-white/20 hover:text-(--text-primary)"
      aria-label="Zavřít modal"
    >
      ×
    </button>

    <h2 id="modal-title" class="mb-(--space-sm) pr-(--space-md) font-(--font-heading) text-lg md:text-xl">
      Nejbližší koncert
    </h2>

    <button
      type="button"
      id="concert-modal-close"
      aria-label="Zavřít detail koncertu"
    >
      ×
    </button>

    <p class="text-xl font-semibold md:text-2xl">
      {concert.data.city}
    </p>

    <p class="mt-(--space-xs) text-(--text-muted)">
      {concert.data.venue}
    </p>

    <p class="mt-(--space-xs) text-sm text-(--text-muted)">
      {formattedDate}
    </p>

    {concert.data.support && (
      <p class="mt-(--space-sm) text-sm text-(--text-muted)">
        Support: {concert.data.support}
      </p>
    )}

    {concert.data.description && (
      <p class="mt-(--space-sm) text-sm leading-relaxed text-(--text-muted)">
        {concert.data.description}
      </p>
    )}

    <div class="mt-(--space-md) flex flex-col gap-(--space-sm) md:flex-row md:items-center">
      {concert.data.ticketUrl && (
        <a
          href={concert.data.ticketUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center rounded-md bg-(--color-accent) px-(--space-md) py-(--space-xs) text-center text-(--text-primary) transition hover:bg-(--color-accent-hover) hover:text-(--color-background)"
        >
          Vstupenky
        </a>
      )}

      {concert.data.website && (
        <a
          href={concert.data.website}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center rounded-md border border-(--text-primary)/20 px-(--space-sm) text-center text-sm underline-offset-2 text-(--text-muted) transition hover:bg-(--text-primary)/10 hover:text-(--text-primary) hover:underline md:min-h-0 md:border-0 md:px-0"
        >
          Detail akce
        </a>
      )}
    </div>
  </div>
</div>

<script is:inline>
  const modal = document.getElementById("concert-modal");
  const content = document.getElementById("modal-content");
  const closeBtn = document.getElementById("close-modal");
  const storageKey = "shizzle-concert-modal-dismissed";
  const dismissedUntil = Number(window.localStorage.getItem(storageKey) || 0);

  if (modal && content && dismissedUntil < Date.now()) {
    setTimeout(() => {
      modal.classList.remove("hidden");
      modal.classList.add("flex");

      requestAnimationFrame(() => {
        modal.classList.remove("opacity-0");
        modal.classList.add("opacity-100");

        content.classList.remove("opacity-0", "scale-95");
        content.classList.add("opacity-100", "scale-100");
      });
    }, 1000);

    function closeModal() {
      window.localStorage.setItem(
        storageKey,
        String(Date.now() + 1000 * 60 * 60 * 24 * 7)
      );
      modal.classList.add("opacity-0");
      content.classList.add("opacity-0", "scale-95");

      setTimeout(() => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }, 300);
    }

    closeBtn?.addEventListener("click", closeModal);

    modal.addEventListener("click", (event) => {
      if (event.target === modal) {
        closeModal();
      }
    });
  }
</script>
