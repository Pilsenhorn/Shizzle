
---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

interface Props {
  clips: CollectionEntry<"clips">[];
}

const { clips } = Astro.props;
---

<section
  id="clips"
  class="px-(--space-sm) py-(--space-lg) md:px-(--space-md) lg:px-(--space-lg)"
>
  <div class="mx-auto max-w-7xl">

    {/* Heading */}
    <div class="mb-(--space-md)">
      <h2 class="text-center text-2xl font-semibold md:text-3xl">
        Videoklipy
      </h2>
    </div>

    {/* Clips grid */}
    <div class="grid grid-cols-1 items-start gap-3 md:grid-cols-2 md:gap-(--space-md)">
      {await Promise.all(
        clips.map(async (clip) => {
          const { Content } = await render(clip);

          return (
            <article
              class="
                mx-auto
                w-[85%]
                self-start
                overflow-hidden
                rounded-xl
                border
                border-(--text-primary)/10
                text-justify
                leading-relaxed
                md:w-full
              "
            >
              {/* YouTube video */}
              <div class="aspect-video">
                <iframe
                  src={`https://www.youtube.com/embed/${clip.data.videoID}`}
                  title={clip.data.title}
                  class="h-full w-full"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              </div>

              {/* Lyrics */}
              <div class="p-(--space-sm)">
                <div
                  data-lyrics
                  tabindex="0"
                  aria-label={`Text písně ${clip.data.title}`}
                  class="
                    h-28
                    overflow-y-auto
                    overscroll-contain
                    pr-2
                    text-justify
                    text-sm
                    leading-relaxed
                    text-(--text-muted)
                    scroll-smooth
                  "
                >
                  <Content />
                </div>
              </div>
            </article>
          );
        })
      )}
    </div>

  </div>
</section>

<style>
  [data-lyrics] {
    scrollbar-width: thin;
    scrollbar-color: var(--color-accent) transparent;
    -webkit-overflow-scrolling: touch;
  }

  [data-lyrics]::-webkit-scrollbar {
    width: 4px;
  }

  [data-lyrics]::-webkit-scrollbar-track {
    background: transparent;
  }

  [data-lyrics]::-webkit-scrollbar-thumb {
    background: var(--color-accent);
    border-radius: 10px;
  }
</style>
