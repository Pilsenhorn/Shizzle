---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

interface Props {
  clips: CollectionEntry<"clips">[];
}

const { clips } = Astro.props;
---

<section
  id="clips"
  class="px-(--space-sm) py-(--space-lg) md:px-(--space-md) lg:px-(--space-lg)"
>
  <div class="mx-auto max-w-7xl">

    <div class="mb-(--space-md)">
      <h2 class="text-center text-2xl font-semibold md:text-3xl">
        Videoklipy
      </h2>
    </div>

    <div class="grid grid-cols-2 items-start gap-3 md:gap-(--space-md)">
      {await Promise.all(
        clips.map(async (clip, index) => {
          const { Content } = await render(clip);
          const clipId = `clip-${index}`;

          return (
            <article
              class="mx-auto w-[85%] self-start overflow-hidden text-justify leading-relaxed rounded-xl border border-(--text-primary)/10 md:w-full"
            >
              <!-- YouTube video -->
              <div class="aspect-video">
                <iframe
                  src={`https://www.youtube.com/embed/${clip.data.videoID}`}
                  title={clip.data.title}
                  class="h-full w-full"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              </div>

              <!-- Lyrics -->
              <div class="p-(--space-sm) [&_p+p]:mt-4">
                <div class="flex items-start gap-3">
                  <div
                    data-lyrics
                    data-expanded="false"
                    class="min-w-0 flex-1 max-h-[3.5em] overflow-hidden text-sm leading-relaxed text-(--text-muted)"
                  >
                    <Content />
                  </div>

                  <button
                    type="button"
                    aria-expanded="false"
                    data-lyrics-toggle
                    class="shrink-0 text-right text-sm font-medium text-(--text-primary) transition hover:text-(--color-accent-hover)"
                  >
                    Zobrazit celý text
                  </button>
                </div>
              </div>
            </article>
          );
        })
      )}
    </div>

  </div>
</section>

<script>
  document.querySelectorAll("[data-lyrics-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const wrapper = button.parentElement;
      const lyrics = wrapper?.querySelector("[data-lyrics]");

      if (!lyrics) return;

      const isExpanded = button.getAttribute("aria-expanded") === "true";

      lyrics.classList.toggle("max-h-[3.5em]", isExpanded);
      lyrics.classList.toggle("max-h-none", !isExpanded);

      button.setAttribute("aria-expanded", String(!isExpanded));
      button.textContent = isExpanded
        ? "Zobrazit celý text"
        : "Skrýt text";
    });
  });
</script>