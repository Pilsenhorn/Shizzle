---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

interface Props {
  settings: CollectionEntry<"settings">;
}

const { settings } = Astro.props;
---

<footer class="mt-(--space-lg) border-t border-(--text-primary)/10 px-(--space-sm) py-(--space-md) md:px-(--space-md) lg:px-(--space-lg)">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-(--space-md) md:grid-cols-3 lg:gap-(--space-lg)">

      <div class="order-1 text-center md:text-left md:order-1">
        <h4 class="text-sm font-semibold uppercase tracking-wide text-(--text-muted)">
          Kontakt
        </h4>

        <p class="mt-(--space-xs) text-sm text-(--text-muted) wrap:anywhere">
          <a
            href={`mailto:${settings.data.bookingEmail}`}
            class="underline-offset-2 transition hover:text-(--text-primary) hover:underline"
          >
            {settings.data.bookingEmail}
          </a>
        </p>
        <p class="mt-(--space-xs) text-sm text-(--text-muted) wrap:anywhere">
          {settings.data.ico}
        </p>

        <p class="mt-(--space-xs) text-sm text-(--text-muted) wrap:anywhere">
          {settings.data.zr}
        </p>


        <div class="mt-(--space-sm) flex items-center justify-center gap-(--space-sm) md:justify-start">
          {settings.data.facebook && (
            <a
              href={settings.data.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="text-(--text-muted) transition hover:scale-110 hover:text-(--text-primary)"
              aria-label="Otevřít Facebook profil"
            >
              <Icon name="simple-icons:facebook" class="h-5 w-5" />
            </a>
          )}

          {settings.data.instagram && (
            <a
              href={settings.data.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="text-(--text-muted) transition hover:scale-110 hover:text-(--text-primary)"
              aria-label="Otevřít Instagram profil"
            >
              <Icon name="simple-icons:instagram" class="h-5 w-5" />
            </a>
          )}

          {settings.data.tiktok && (
            <a
              href={settings.data.tiktok}
              target="_blank"
              rel="noopener noreferrer"
              class="text-(--text-muted) transition hover:scale-110 hover:text-(--text-primary)"
              aria-label="Otevřít TikTok profil"
            >
              <Icon name="simple-icons:tiktok" class="h-5 w-5" />
            </a>
          )}

          {settings.data.spotify && (
            <a
              href={settings.data.spotify}
              target="_blank"
              rel="noopener noreferrer"
              class="text-(--text-muted) transition hover:scale-110 hover:text-(--text-primary)"
              aria-label="Otevřít Spotify profil"
            >
              <Icon name="simple-icons:spotify" class="h-5 w-5" />
            </a>
          )}

          {settings.data.youtube && (
            <a
              href={settings.data.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="text-(--text-muted) transition hover:scale-110 hover:text-(--text-primary)"
              aria-label="Otevřít YouTube kanál"
            >
              <Icon name="simple-icons:youtube" class="h-5 w-5" />
            </a>
          )}
        </div>
      </div>

      <div class="text-center order-3 md:order-2">
        <h3>
          <img
          src="/logo/shizzle-logo.webp"
          alt="Shizzle"
          class="mx-auto w-80 md:w-96 lg:w-120"
          loading="eager"
        />
        </h3>
      </div>

      <div class="text-center order-2 md:order-3 md:text-right ">
        <h4 class="text-sm font-semibold uppercase tracking-wide text-(--text-muted)">
          Navigace
        </h4>

        <ul class="mt-(--space-xs) space-y-(--space-xs) text-sm text-(--text-muted)">
          <li><a href="/#shows" class="transition hover:text-(--text-primary)">Koncerty</a></li>
          <li><a href="/#media" class="transition hover:text-(--text-primary)">Diskografie</a></li>
          <li><a href="/#about" class="transition hover:text-(--text-primary)">O mně</a></li>
          <li><a href="/#contact" class="transition hover:text-(--text-primary)">Booking</a></li>
        </ul>
      </div>


    </div>

    <div class="mt-(--space-md) border-t border-(--text-primary)/10 pt-(--space-sm)">
      <p class="text-center text-xs text-(--text-muted)">
        © 2026 Shizzle. Všechna práva vyhrazena.
      </p>
      <p class="text-center text-xs text-(--text-muted)">
        Design & vývoj <a 
          href="https://mikulenka.dev/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="
            underline-offset-2 
            transition hover:text-(--text-primary) 
            hover:underline
            ">
            MWStudio
          </a>
      </p>
    </div>
  </div>
</footer>
