
---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  content: CollectionEntry<"pages">;
}

const { content } = Astro.props;
const { Content } = await render(content);
---

<section
  id="about"
  class="
    px-(--space-sm)
    py-(--space-lg)
    md:px-(--space-md)
    lg:px-(--space-lg)
  "
>
  <div class="mx-auto max-w-7xl">

    {/* Heading */}
    <div class="mb-(--space-md) text-center">
      <h2
        class="
          text-2xl
          font-semibold
          text-(--color-accent)
          md:text-3xl
        "
      >
        O mně
      </h2>

      <div
        class="
          mx-auto
          mt-4
          h-px
          w-12
          bg-(--color-accent)
        "
      ></div>
    </div>

    {/* Markdown content */}
    <article
      class="
        about-content
        mx-auto
        max-w-3xl
        text-left
        text-base
        leading-relaxed
        text-(--text-primary)
        md:text-lg
      "
    >
      <Content />
    </article>

  </div>
</section>

<style>
  .about-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .about-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .about-content :global(strong) {
    font-weight: 600;
    color: var(--color-accent);
  }

  .about-content :global(em) {
    font-style: italic;
  }

  .about-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .about-content :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .about-content :global(ul) {
    margin: 1rem 0;
    padding-left: 1.5rem;
    list-style-type: disc;
  }

  .about-content :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
    list-style-type: decimal;
  }

  .about-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .about-content :global(a) {
    text-underline-offset: 3px;
  }

  .about-content :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--color-accent);
    font-style: italic;
  }
</style>
