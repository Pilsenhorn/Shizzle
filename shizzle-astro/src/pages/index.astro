---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Shows from "../components/Shows.astro";
import ConcertModal from "../components/ConcertModal.astro";
import Media from "../components/Media.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import StickyCTA from "../components/StickyCTA.astro";
import Music from "../components/Music.astro";
import SpotifyPlayer from "../components/SpotifyPlayer.astro";

import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

//concerts
const concerts = await getCollection("concerts");

const today = new Date();
today.setHours(0, 0, 0, 0);

const upcoming = concerts
  .filter((concert) => {
    const concertDate = new Date(
      `${concert.data.date}T00:00:00`
    );

    return concertDate >= today;
  })
  .sort(
    (a, b) =>
      new Date(`${a.data.date}T00:00:00`).getTime() -
      new Date(`${b.data.date}T00:00:00`).getTime()
  );

const nextConcert = upcoming[0];

// modal logic
let showModal = false;

if (nextConcert) {
  const diff =
    (
      new Date(`${nextConcert.data.date}T00:00:00`).getTime() -
      today.getTime()
    ) /
    (1000 * 60 * 60 * 24);

  showModal = diff >= 0 && diff <= 30;
}

//albums
const albums = await getCollection("albums");

//pages
const pages = await getCollection("pages");
const about = pages.find((p) => p.id.includes("about"));
if (!about) {
  throw new Error("about.md not found in content/pages");
}


//settings
const settingsCollection = await getCollection("settings");
const settings = settingsCollection[0];

//social
const social = await getCollection("social");

---

<Layout
    title="Shizzle | Rap"
    description="Shizzle je český rapper a hudební umělec. Poslechni si jeho hudbu, podívej se na videa a zjisti, kde hraje nejbližší koncert."
>
  <Header />
  <main id="main-content">
    <Hero />
    <Shows concerts={upcoming} />
    <Media socials={social} />
    <Music albums={albums} />
    <SpotifyPlayer />
    <About content={about} />
    <Contact settings={settings} />
    <Footer settings={settings}  />
    <StickyCTA settings={settings} />
    {showModal && <ConcertModal concert={nextConcert} />}
  </main>
</Layout>
